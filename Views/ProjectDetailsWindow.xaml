<Window x:Class="TTGClient.Views.ProjectDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project details" Height="600" Width="720" MinHeight="500" MinWidth="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,22">
            <Border Width="72" Height="72" CornerRadius="15" Background="#293342" ClipToBounds="True">
                <Image x:Name="ProjectIconImage" Stretch="UniformToFill" />
            </Border>
            <StackPanel Margin="16,2,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="ProjectTitleText" Text="Project name" FontSize="22" FontWeight="Bold" MaxWidth="520" />
                <TextBlock x:Name="ProjectSourceText" Text="Source · Author" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,6,0,0" />
            </StackPanel>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="ABOUT THIS PROJECT" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                <TextBlock x:Name="ProjectDescriptionText" FontSize="13" LineHeight="21" Margin="0,9,0,22" />
                <UniformGrid Columns="2" Rows="2" Margin="0,0,0,22">
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,8,8">
                        <StackPanel><TextBlock Text="DOWNLOADS" FontSize="9" Foreground="{StaticResource MutedTextBrush}"/><TextBlock x:Name="DownloadsText" Text="0" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,8">
                        <StackPanel><TextBlock Text="LAST UPDATED" FontSize="9" Foreground="{StaticResource MutedTextBrush}"/><TextBlock x:Name="UpdatedText" Text="Unknown" FontSize="14" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,8,0">
                        <StackPanel><TextBlock Text="SUPPORTED VERSIONS" FontSize="9" Foreground="{StaticResource MutedTextBrush}"/><TextBlock x:Name="VersionsText" Text="Unknown" FontSize="11" Margin="0,7,0,0"/></StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,0">
                        <StackPanel><TextBlock Text="CATEGORIES" FontSize="9" Foreground="{StaticResource MutedTextBrush}"/><TextBlock x:Name="CategoriesText" Text="Unknown" FontSize="11" Margin="0,7,0,0"/></StackPanel>
                    </Border>
                </UniformGrid>
                <TextBlock Text="PHASE 1 NOTE" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                <TextBlock Text="This build opens the official project page for download. In-app mod installation and dependency handling will come in a later phase." Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,8,0,0" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Close" Style="{StaticResource SecondaryButton}" Click="Close_Click" Margin="0,0,10,0" />
            <Button Content="Open official project page  ↗" Style="{StaticResource PrimaryButton}" Click="OpenProject_Click" />
        </StackPanel>
    </Grid>
</Window>
