<Window x:Class="TTGClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TTG Client" Height="820" Width="1380" MinHeight="700" MinWidth="1120"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" Loaded="Window_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Persistent navigation rail -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,24">
                    <Border Width="48" Height="48" CornerRadius="14" Background="#244D38" HorizontalAlignment="Left">
                        <TextBlock Text="TTG" FontSize="15" FontWeight="ExtraBold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="TTG Client" FontSize="23" FontWeight="Bold" Margin="0,14,0,2" />
                    <TextBlock Text="MINECRAFT MOD MANAGER" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="18,16,18,22">
                    <Border Height="1" Background="{StaticResource BorderBrushSoft}" Margin="0,0,0,14" />
                    <TextBlock Text="TTG CLIENT  ·  PHASE 1" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                    <TextBlock Text="Browse &amp; discover mods" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,5,0,0" />
                </StackPanel>

                <StackPanel Margin="12,0,12,0">
                    <TextBlock Text="WORKSPACE" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="Bold" Margin="10,0,0,10" />
                    <Button x:Name="BrowseNavButton" Click="BrowseNav_Click" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Margin="0,0,0,7" Background="{StaticResource AccentDarkBrush}" BorderBrush="{StaticResource AccentDarkBrush}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="⌕" FontSize="20" Width="28" VerticalAlignment="Center"/><TextBlock Text="Browse mods" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button x:Name="InstancesNavButton" Click="InstancesNav_Click" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Margin="0,0,0,7" Background="Transparent" BorderBrush="Transparent">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="▦" FontSize="18" Width="28" VerticalAlignment="Center"/><TextBlock Text="Instances" VerticalAlignment="Center"/><TextBlock Text="SOON" FontSize="8" Foreground="{StaticResource MutedTextBrush}" Margin="12,1,0,0" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button x:Name="DownloadsNavButton" Click="DownloadsNav_Click" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Margin="0,0,0,7" Background="Transparent" BorderBrush="Transparent">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="↓" FontSize="20" Width="28" VerticalAlignment="Center"/><TextBlock Text="Downloads" VerticalAlignment="Center"/><TextBlock Text="SOON" FontSize="8" Foreground="{StaticResource MutedTextBrush}" Margin="12,1,0,0" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Border Height="1" Background="{StaticResource BorderBrushSoft}" Margin="8,14,8,14" />
                    <TextBlock Text="APP" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="Bold" Margin="10,0,0,10" />
                    <Button x:Name="SettingsNavButton" Click="SettingsNav_Click" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="⚙" FontSize="18" Width="28" VerticalAlignment="Center"/><TextBlock Text="Settings" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main workspace -->
        <Grid Grid.Column="1" Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="96" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1" Background="#12161F">
                <Grid Margin="30,0,30,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="WorkspaceTitle" Text="Browse mods" FontSize="25" FontWeight="Bold" />
                        <TextBlock x:Name="WorkspaceSubtitle" Text="Discover projects from Modrinth and CurseForge." Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,5,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#1C222E" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="12,8" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="API BROWSER" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <!-- Browse screen -->
                <Grid x:Name="BrowseView" Visibility="Visible">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="252"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#141923" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,1,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="22,22,22,24">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <TextBlock Text="☷" FontSize="18" Foreground="{StaticResource AccentBrush}" Margin="0,0,9,0" />
                                    <TextBlock Text="FILTERS" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Minecraft version" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,7" />
                                <ComboBox x:Name="VersionComboBox" IsEditable="True" IsTextSearchEnabled="False" SelectedIndex="5" Margin="0,0,0,18">
                                    <ComboBoxItem Content="Any" />
                                    <ComboBoxItem Content="1.21.8" />
                                    <ComboBoxItem Content="1.21.5" />
                                    <ComboBoxItem Content="1.21.4" />
                                    <ComboBoxItem Content="1.21.1" />
                                    <ComboBoxItem Content="1.20.1" />
                                    <ComboBoxItem Content="1.19.2" />
                                    <ComboBoxItem Content="1.18.2" />
                                    <ComboBoxItem Content="1.16.5" />
                                </ComboBox>

                                <TextBlock Text="Mod loader" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,7" />
                                <ComboBox x:Name="LoaderComboBox" SelectedIndex="0" Margin="0,0,0,18">
                                    <ComboBoxItem Content="Any" />
                                    <ComboBoxItem Content="Fabric" />
                                    <ComboBoxItem Content="Forge" />
                                    <ComboBoxItem Content="NeoForge" />
                                    <ComboBoxItem Content="Quilt" />
                                </ComboBox>

                                <TextBlock Text="Category" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,7" />
                                <ComboBox x:Name="CategoryComboBox" SelectedIndex="0" Margin="0,0,0,18">
                                    <ComboBoxItem Content="All categories" />
                                    <ComboBoxItem Content="Adventure" />
                                    <ComboBoxItem Content="Technology" />
                                    <ComboBoxItem Content="Magic" />
                                    <ComboBoxItem Content="Optimization" />
                                    <ComboBoxItem Content="World Generation" />
                                    <ComboBoxItem Content="Mobs" />
                                    <ComboBoxItem Content="Decoration" />
                                    <ComboBoxItem Content="Utility &amp; QoL" />
                                    <ComboBoxItem Content="Food" />
                                    <ComboBoxItem Content="Storage" />
                                    <ComboBoxItem Content="Transportation" />
                                </ComboBox>

                                <TextBlock Text="Environment" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,7" />
                                <ComboBox x:Name="EnvironmentComboBox" SelectedIndex="0" Margin="0,0,0,18">
                                    <ComboBoxItem Content="All environments" />
                                    <ComboBoxItem Content="Client only" />
                                    <ComboBoxItem Content="Server only" />
                                    <ComboBoxItem Content="Client + server" />
                                </ComboBox>

                                <TextBlock Text="Sort by" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,7" />
                                <ComboBox x:Name="SortComboBox" SelectedIndex="0" Margin="0,0,0,18">
                                    <ComboBoxItem Content="Relevance" />
                                    <ComboBoxItem Content="Downloads" />
                                    <ComboBoxItem Content="Recently Updated" />
                                    <ComboBoxItem Content="Newest" />
                                    <ComboBoxItem Content="Followers" />
                                    <ComboBoxItem Content="Name" />
                                </ComboBox>

                                <Border Background="#1D2531" CornerRadius="9" Padding="11" Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock Text="Compatibility filters" FontWeight="SemiBold" FontSize="11" />
                                        <TextBlock Text="Version and loader filters are sent to the source API where supported." FontSize="10" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>
                                <Button Style="{StaticResource PrimaryButton}" Click="Search_Click" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="⌕" FontSize="18" Margin="0,0,7,0"/><TextBlock Text="Apply filters" VerticalAlignment="Center"/></StackPanel>
                                </Button>
                                <TextBlock x:Name="FilterFootnote" Text="CurseForge environment filtering isn't available through its search endpoint." Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,12,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Grid Grid.Column="1" Margin="26,22,28,22">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Find your next mod" FontSize="18" FontWeight="Bold" />
                                <TextBlock Text="Search both libraries from one place." FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="ResultsCountText" Grid.Column="1" Text="Ready to search" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                        </Grid>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
                            <Button x:Name="AllSourcesButton" Content="All sources" Click="AllSources_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Background="{StaticResource AccentDarkBrush}" BorderBrush="{StaticResource AccentDarkBrush}" />
                            <Button x:Name="ModrinthButton" Content="Modrinth" Click="Modrinth_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Background="#252B38" />
                            <Button x:Name="CurseForgeButton" Content="CurseForge" Click="CurseForge_Click" Style="{StaticResource SecondaryButton}" Background="#252B38" />
                        </StackPanel>

                        <Grid Grid.Row="2" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="2">
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="⌕" FontSize="23" Foreground="{StaticResource MutedTextBrush}" Margin="12,0,7,0" VerticalAlignment="Center" />
                                    <TextBox x:Name="QueryTextBox" BorderThickness="0" Background="Transparent" Padding="4,10" FontSize="13" VerticalContentAlignment="Center" BorderBrush="Transparent" ToolTip="Search mods by name or keyword" KeyDown="QueryTextBox_KeyDown" />
                                </DockPanel>
                            </Border>
                            <Button Grid.Column="1" Content="Search" Style="{StaticResource PrimaryButton}" Click="Search_Click" Margin="10,0,0,0" MinWidth="95" />
                        </Grid>

                        <Border x:Name="StatusBanner" Grid.Row="3" Background="#202A35" BorderBrush="#374657" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,12" Visibility="Collapsed">
                            <TextBlock x:Name="StatusText" FontSize="11" Foreground="#D4DEEA" />
                        </Border>

                        <Grid Grid.Row="4">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="ProjectsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,0,0,11">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <Border Width="48" Height="48" Background="#2C3443" CornerRadius="10" ClipToBounds="True" VerticalAlignment="Top">
                                                        <Image Source="{Binding IconUrl, Converter={StaticResource ImageUrlConverter}}" Width="48" Height="48" Stretch="UniformToFill" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,14,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" MaxWidth="560" TextTrimming="CharacterEllipsis" />
                                                            <Border Background="#293342" CornerRadius="5" Padding="6,3" Margin="9,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding SourceName}" FontSize="9" Foreground="{StaticResource MutedTextBrush}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,6,0,7" MaxHeight="34" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding TagsText}" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="SemiBold" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                                            <TextBlock Text="↓ " Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                                                            <TextBlock Text="{Binding FormattedDownloads}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                                                            <TextBlock Text=" downloads" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                                                            <TextBlock Text="  ·  " Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                                                            <TextBlock Text="{Binding Author}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Content="Details  ↗" Style="{StaticResource SecondaryButton}" Tag="{Binding}" Click="ProjectDetails_Click" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" MaxWidth="400">
                                <Border Width="68" Height="68" Background="#1E2A27" CornerRadius="20" HorizontalAlignment="Center">
                                    <TextBlock Text="⌕" FontSize="36" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock x:Name="EmptyTitle" Text="No mods found" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,18,0,6" />
                                <TextBlock x:Name="EmptyMessage" Text="Try another keyword or adjust your filters." FontSize="12" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" TextAlignment="Center" />
                            </StackPanel>
                            <Border x:Name="LoadingOverlay" Background="#B810131A" CornerRadius="10" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ProgressBar IsIndeterminate="True" Width="220" Height="4" Foreground="{StaticResource AccentBrush}" Background="#35404E" BorderThickness="0" />
                                    <TextBlock Text="Searching mod libraries…" Foreground="{StaticResource MutedTextBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="5" Margin="0,13,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="PageText" Text="Page 1" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="PreviousPageButton" Content="← Previous" Style="{StaticResource SecondaryButton}" Click="PreviousPage_Click" Margin="0,0,8,0" IsEnabled="False" />
                                <Button x:Name="NextPageButton" Content="Next →" Style="{StaticResource SecondaryButton}" Click="NextPage_Click" IsEnabled="False" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Phase 2/3 placeholders retain the planned IA without pretending those features exist. -->
                <Grid x:Name="PlaceholderView" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                        <Border Width="84" Height="84" Background="#1E2A27" CornerRadius="25" HorizontalAlignment="Center">
                            <TextBlock x:Name="PlaceholderGlyph" Text="▦" FontSize="36" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="PlaceholderTitle" Text="Instances" FontSize="27" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,22,0,0" />
                        <TextBlock x:Name="PlaceholderDescription" Text="Create isolated Minecraft profiles with a game version, loader, Java runtime and RAM settings." FontSize="13" Foreground="{StaticResource MutedTextBrush}" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,9,0,0" />
                        <Border Background="#1B222D" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,22,0,0">
                            <TextBlock Text="Planned for a future phase" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        </Border>
                        <Button Content="Back to Browse" Style="{StaticResource PrimaryButton}" Click="BrowseNav_Click" Margin="0,22,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Settings screen -->
                <Grid x:Name="SettingsView" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="42,34,42,42" MaxWidth="780" HorizontalAlignment="Left">
                            <TextBlock Text="API connections" FontSize="21" FontWeight="Bold" />
                            <TextBlock Text="Configure access to external mod libraries." Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,6,0,22" />
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="14" Padding="22">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Width="38" Height="38" Background="#382A20" CornerRadius="10"><TextBlock Text="CF" Foreground="#FFB66D" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="CurseForge API key" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock x:Name="ApiKeyStateText" Text="Not configured" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="CurseForge requires an API key for searches. Add your own key here; TTG Client encrypts it for your Windows user account before saving it locally." FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,16" />
                                    <TextBlock Text="API key" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,7" />
                                    <PasswordBox x:Name="CurseForgeKeyBox" MinWidth="400" />
                                    <TextBlock Text="You can also set CURSEFORGE_API_KEY as a Windows environment variable. That takes priority over the saved key." FontSize="10" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,18" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Save key" Style="{StaticResource PrimaryButton}" Click="SaveApiKey_Click" />
                                        <Button Content="Clear saved key" Style="{StaticResource SecondaryButton}" Click="ClearApiKey_Click" Margin="10,0,0,0" />
                                    </StackPanel>
                                    <TextBlock x:Name="ApiKeyFeedbackText" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="14" Padding="22" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="About TTG Client" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="Phase 1 includes the browse interface, search, source selection, filters, project details and paging. Instance creation, downloads and launching will be implemented in later phases." FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0" />
                                    <TextBlock Text="Modrinth API: public project search · CurseForge API: requires API key" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
